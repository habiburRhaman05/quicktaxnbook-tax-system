DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Used only for migrations. Same value as DATABASE_URL for a plain Postgres
# host; on Vercel + Neon, DATABASE_URL should be Neon's POOLED connection
# string instead (hostname has "-pooler" in it) - append `&pgbouncer=true` to
# it too, or Prisma's prepared statements will intermittently collide across
# concurrent serverless invocations sharing the same PgBouncer connection.
# DIRECT_URL always stays the direct (non-pooled) one; migrations need it.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Email (Gmail SMTP) - FORM_EMAIL doubles as the SMTP auth user and the "From" address
FORM_EMAIL="you@example.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"

# JWT
JWT_SECRET="generate-a-long-random-string"
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=30
JWT_CLIENT_LOGIN_EXPIRATION_MINUTES=10
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5

# PII encryption (SSN/EIN) - ENCRYPTION_KEY must be exactly 64 hex chars (32 bytes, AES-256-GCM)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
BLIND_INDEX_PEPPER=""

# App URLs
APP_NAME="Qicktaxnbook365"
APP_BASE_URL="http://localhost:8000"
CLIENT_PORTAL_URL="http://localhost:3000"

# Comma-separated list of frontend origins allowed to call this API with credentials
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:6767"

# File uploads - Vercel Blob (Storage tab on your Vercel project -> create a
# Blob store -> copy its read/write token here). Same token works locally.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# GoHighLevel (GHL) - optional. With GHL_ENABLED="false" the app behaves
# exactly as before and makes no GHL call at all.
#
# Two private-integration tokens, created in GHL under Settings > Private
# Integrations (they must be enabled on Labs first):
#   1. AGENCY token  -> only used to check that a sub-account (location) exists
#                       before we ask the firm owner for that sub-account's own
#                       token. Give it the narrowest scopes that allow reading
#                       locations.
#   2. SUB-ACCOUNT token -> per firm. The firm owner pastes it in the Connect
#                       GHL flow, we verify it live, then store it AES-256-GCM
#                       encrypted in Integration.configEncrypted. It is never
#                       read from env and never logged.
#
# GHL rejects any request without a valid `Version` header.
# ---------------------------------------------------------------------------
GHL_ENABLED="false"
GHL_API_BASE_URL="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-07-28"
GHL_TIMEOUT_MS=10000
GHL_MAX_RETRIES=3

GHL_AGENCY_PIT=""
GHL_COMPANY_ID=""

# Only used by `npm run dev` / `npm start` locally - Vercel ignores this and
# manages the listener itself.
PORT=8000

# Seed - Platform Owner (super admin), created once by `npm run db:seed`
PLATFORM_OWNER_EMAIL="owner@example.com"
PLATFORM_OWNER_PASSWORD="ChangeMe123!"
PLATFORM_OWNER_FIRST_NAME="Platform"
PLATFORM_OWNER_LAST_NAME="Owner"

# GoHighLevel workflow webhooks (Inbound Webhook trigger URLs), one per event.
# The app posts the event data here; the workflow sends the email. MOCK values
# for now; replace with the real workflow URLs.
GHL_WEBHOOK_ONBOARDING_INVITE_URL="https://services.leadconnectorhq.com/hooks/MOCK_LOCATION/webhook-trigger/mock-onboarding-invite"
GHL_WEBHOOK_CLIENT_ONBOARDED_URL="https://services.leadconnectorhq.com/hooks/MOCK_LOCATION/webhook-trigger/mock-client-onboarded"
GHL_WEBHOOK_CLIENT_LOGIN_OTP_URL="https://services.leadconnectorhq.com/hooks/MOCK_LOCATION/webhook-trigger/mock-client-login-otp"
