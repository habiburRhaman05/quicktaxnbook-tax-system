  quietHours   Json?
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  firm      Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  template  NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([firmId, target, isActive])
}

/// Scheduled reminder instances (worker polls scheduledFor)
model Reminder {
  id                 String              @id @default(cuid())
  firmId             String
  ruleId             String?
  target             ReminderTarget
  caseId             String?
  documentRequestId  String?
  signatureRequestId String?
  invoiceId          String?
  appointmentId      String?
  taskId             String?
  channel            NotificationChannel
  scheduledFor       DateTime
  status             ReminderStatus      @default(SCHEDULED)
  attempt            Int                 @default(1)
  sentAt             DateTime?
  notificationId     String?
  error              String?
  createdAt          DateTime            @default(now())

  firm             Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  rule             ReminderRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  case             Case?             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentRequest  DocumentRequest?  @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  signatureRequest SignatureRequest? @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  appointment      Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([firmId, target])
}

