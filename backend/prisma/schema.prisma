// =============================================================================
// 1. TENANCY / FIRM
// =============================================================================

model Firm {
  id           String     @id @default(cuid())
  name         String
  legalName    String?
  slug         String     @unique
  einEncrypted String?
  einLast4     String?
  website      String?
  domain       String? // vanity subdomain/custom domain requested at onboarding (see FirmDomain for verified custom domains)
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String     @default("US")
  timezone     String     @default("America/New_York")
  locale       String     @default("en-US")
  currency     String     @default("USD")
  status       FirmStatus @default(TRIAL)

  // GoHighLevel linkage. Deliberately set ONLY by the "Connect GHL" flow
  // (agency private-integration token pre-check, then the firm's own
  // sub-account private-integration token) - never created silently during
  // firm onboarding. `ghlLocationId` is the sub-account id and is the tenant
  // key every GHL call for this firm must be scoped to.
  ghlLocationId  String?   @unique
  ghlCompanyId   String?
  ghlConnectedAt DateTime?

  // Responsible-party identity (the person accountable for this firm/agency).
  // EIN + SSN combined form the uniqueness key so the same business/person can
  // never be onboarded twice, even if one of the two isn't available.
  licenseNumber     String? // CTEC/EA/CPA/state business license, if any
  licenseType       String? // free text: "CTEC", "EA", "CPA", "STATE_BUSINESS", ...
  ownerSsnEncrypted String? // AES-256-GCM encrypted
  ownerSsnLast4     String?
  identityHash      String? @unique // HMAC-SHA256(pepper, normalized EIN/SSN) blind index - dedup key

  createdByPlatformAdminId String?
  createdByPlatformAdmin   User?   @relation("FirmOnboardedBy", fields: [createdByPlatformAdminId], references: [id], onDelete: SetNull)

  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branding      FirmBranding?
  settings      FirmSettings?
  subscription  FirmSubscription?
  stripeAccount StripeAccount?
  voiceAgent    VoiceAgentConfig?

  domains               FirmDomain[]
  sequences             FirmSequence[]
  featureFlags          FirmFeatureFlag[]
  members               FirmMember[]
  roles                 Role[]
  invitations           Invitation[]
  onboardingLinks       OnboardingLink[]
  sessions              Session[]
  clients               Client[]
  cases                 Case[]
  engagementTypes       EngagementType[]
  pipelines             Pipeline[]
  automationRules       AutomationRule[]
  files                 StoredFile[]
  documentCategories    DocumentCategory[]
  documentRequests      DocumentRequest[]
  documents             Document[]
  docRequestTemplates   DocumentRequestTemplate[]
  returnDrafts          ReturnDraft[]
  returnSummaries       ReturnSummary[]
  extractionJobs        ExtractionJob[]
  eFilings              EFiling[]
  signatureTemplates    SignatureTemplate[]
  signatureRequests     SignatureRequest[]
  serviceItems          ServiceItem[]
  invoices              Invoice[]
  payments              Payment[]
  tasks                 Task[]
  taskTemplates         TaskTemplate[]
  messageThreads        MessageThread[]
  messages              Message[]
  appointmentTypes      AppointmentType[]
  appointments          Appointment[]
  notificationTemplates NotificationTemplate[]
  notifications         Notification[]
  reminderRules         ReminderRule[]
  reminders             Reminder[]
  phoneNumbers          PhoneNumber[]
  callLogs              CallLog[]
  reportSchedules       ReportSchedule[]
  reportRuns            ReportRun[]
  importJobs            ImportJob[]
  auditLogs             AuditLog[]
  integrations          Integration[]
  ghlPipelines          GhlPipeline[]
  ghlOpportunities      GhlOpportunity[]
  webhookEndpoints      WebhookEndpoint[]
  apiKeys               ApiKey[]
  usageRecords          UsageRecord[]
  tags                  Tag[]
  customFields          CustomFieldDefinition[]
  notes                 Note[]

  @@index([status])
}

/// White-label branding (logo, colors, sender identity)
model FirmBranding {
  id                  String   @id @default(cuid())
  firmId              String   @unique
  displayName         String?
  logoFileId          String?
  faviconFileId       String?
  primaryColor        String?
  secondaryColor      String?
  accentColor         String?
  emailSenderName     String?
  emailSenderAddress  String?
  emailReplyTo        String?
  emailDomainVerified Boolean  @default(false)
  emailDnsRecords     Json?
  smsSenderId         String?
  portalWelcomeText   String?
  emailFooterHtml     String?
  customCss           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  firm    Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  logo    StoredFile? @relation("BrandingLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  favicon StoredFile? @relation("BrandingFavicon", fields: [faviconFileId], references: [id], onDelete: SetNull)
}

/// Custom portal domains, e.g. portal.westgatetax.com
model FirmDomain {
  id                String    @id @default(cuid())
  firmId            String
  domain            String    @unique
  isPrimary         Boolean   @default(false)
  verificationToken String?
  verifiedAt        DateTime?
  sslStatus         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
}

model FirmSettings {
  id                         String         @id @default(cuid())
  firmId                     String         @unique
  teamCaseVisibility         CaseVisibility @default(ASSIGNED_ONLY)
  requireStaffMfa            Boolean        @default(true)
  clientOtpChannels          OtpChannel[]   @default([EMAIL, SMS])
  staffSessionTtlMinutes     Int            @default(720)
  clientSessionTtlMinutes    Int            @default(10080)
  documentRetentionYears     Int            @default(7)
  autoCreateNextYearCases    Boolean        @default(true)
  nextYearCaseCreationMonth  Int?           @default(1)
  currentTaxYear             Int?
  allowClientBooking         Boolean        @default(true)
  autoTriggerEsignOnApproval Boolean        @default(true)
  autoAdvanceOnSignature     Boolean        @default(true)
  invoiceNumberPrefix        String         @default("INV-")
  caseNumberPrefix           String         @default("C-")
  defaultInvoiceDueDays      Int            @default(14)
  stuckCaseThresholdDays     Int            @default(7)
  extra                      Json?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

/// Per-firm counters for human-readable numbers (case #, invoice #). Increment with UPDATE ... RETURNING.
model FirmSequence {
  firmId    String
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@id([firmId, key])
}

model FirmFeatureFlag {
  id        String   @id @default(cuid())
  firmId    String
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, key])
}

// =============================================================================
// 2. IDENTITY, AUTH, RBAC
// =============================================================================

/// Global identity. One person can be staff in one firm and a client portal user elsewhere.
model User {
  id               String      @id @default(cuid())
  email            String?     @unique // store lowercased
  phone            String?     @unique // E.164
  firstName        String?
  lastName         String?
  displayName      String?
  avatarFileId     String?
  passwordHash     String? // null for passwordless clients
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  mfaEnabled       Boolean     @default(false)
  status           UserStatus  @default(ACTIVE)
  accountRole      AccountRole
  locale           String?
  timezone         String?
  lastLoginAt      DateTime?
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  avatar StoredFile? @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  memberships          FirmMember[]
  clientAccess         ClientAccess[]
  personProfiles       ClientPerson[]
  sessions             Session[]
  otpChallenges        OtpChallenge[]
  mfaFactors           MfaFactor[]
  recoveryCodes        MfaRecoveryCode[]
  verificationTokens   VerificationToken[]
  invitationsSent      Invitation[]             @relation("InvitedBy")
  onboardingLinksMade  OnboardingLink[]         @relation("OnboardingCreatedBy")
  firmsOnboarded       Firm[]                   @relation("FirmOnboardedBy")
  uploadedFiles        StoredFile[]             @relation("FileUploadedBy")
  documentVersions     DocumentVersion[]
  docRequestsCreated   DocumentRequest[]        @relation("DocRequestCreatedBy")
  docRequestsReviewed  DocumentRequest[]        @relation("DocRequestReviewedBy")
  draftsUploaded       ReturnDraft[]            @relation("DraftUploadedBy")
  draftsDecided        ReturnDraft[]            @relation("DraftDecidedBy")
  draftComments        DraftComment[]
  summariesVerified    ReturnSummary[]
  signatureReqsSent    SignatureRequest[]       @relation("SignatureSentBy")
  signerRecords        SignatureSigner[]
  invoicesCreated      Invoice[]                @relation("InvoiceCreatedBy")
  paymentsMade         Payment[]                @relation("PaymentPaidBy")
  tasksCreated         Task[]                   @relation("TaskCreatedBy")
  tasksCompleted       Task[]                   @relation("TaskCompletedBy")
  taskComments         TaskComment[]
  messages             Message[]
  messageReceipts      MessageReceipt[]
  appointmentsBooked   Appointment[]            @relation("AppointmentBookedBy")
  appointmentAttendees AppointmentAttendee[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  stageChanges         CaseStageHistory[]
  assignmentsMade      CaseAssignment[]         @relation("AssignmentMadeBy")
  callLogs             CallLog[]
  auditLogs            AuditLog[]
  importJobs           ImportJob[]
  notes                Note[]
  apiKeysCreated       ApiKey[]
  ghlAgencyConnections GhlAgencyConnection[]   @relation("GhlAgencyConnectedBy")

  @@index([status])
  @@index([accountRole])
}

/// Staff/admin membership in a firm. Admin vs Team is expressed via roles (a person can hold both).
model FirmMember {
  id              String       @id @default(cuid())
  firmId          String
  userId          String
  staffType       StaffType    @default(PREPARER)
  title           String?
  status          MemberStatus @default(INVITED)
  isOwner         Boolean      @default(false)
  maxActiveCases  Int? // capacity for workload view
  color           String? // calendar color
  ptin            String? // preparer tax ID number
  efin            String? // LATER: per-preparer EFIN if needed
  hourlyRateCents Int? // LATER: time tracking
  joinedAt        DateTime?
  deactivatedAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles                  FirmMemberRole[]
  casesAsPreparer        Case[]                  @relation("CasePreparer")
  casesAsReviewer        Case[]                  @relation("CaseReviewer")
  caseAssignments        CaseAssignment[]        @relation("AssignmentMember")
  caseCollaborations     CaseCollaborator[]
  tasksAssigned          Task[]                  @relation("TaskAssignee")
  appointmentsHosted     Appointment[]           @relation("AppointmentHost")
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  calendarConnections    CalendarConnection[]
  callsEscalated         CallLog[]               @relation("CallEscalatedTo")
  signerRecords          SignatureSigner[]       @relation("SignerMember")

  @@unique([firmId, userId])
  @@index([firmId, status])
  @@index([userId])
}

/// Firm-scoped role. System roles: "admin", "team". Custom roles possible later.
model Role {
  id          String   @id @default(cuid())
  firmId      String
  key         String // "admin", "team", "reviewer", ...
  name        String
  description String?
  isSystem    Boolean  @default(false)
  permissions String[] // e.g. ["case.read.all","case.reassign","billing.manage"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm    Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  members FirmMemberRole[]

  @@unique([firmId, key])
}

model FirmMemberRole {
  memberId    String
  roleId      String
  grantedAt   DateTime @default(now())
  grantedById String?

  member FirmMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([roleId])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  firmId        String? // active firm context
  tokenHash     String    @unique
  ipAddress     String?
  userAgent     String?
  deviceLabel   String?
  mfaVerifiedAt DateTime?
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  firm Firm? @relation(fields: [firmId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

/// Passwordless login + MFA + signature OTPs (FR-1, FR-2)
model OtpChallenge {
  id          String     @id @default(cuid())
  userId      String?
  firmId      String?
  destination String // email or E.164 phone
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  ipAddress   String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destination, purpose, createdAt])
  @@index([expiresAt])
}

model MfaFactor {
  id              String    @id @default(cuid())
  userId          String
  type            MfaType
  label           String?
  secretEncrypted String? // TOTP secret
  phone           String? // SMS factor
  credentialId    String?   @unique // WebAuthn (LATER)
  publicKey       String? // WebAuthn (LATER)
  isPrimary       Boolean   @default(false)
  verifiedAt      DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String                @id @default(cuid())
  userId     String
  type       VerificationTokenType
  tokenHash  String                @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Team member invitations (unlimited seats)
model Invitation {
  id          String           @id @default(cuid())
  firmId      String
  email       String
  firstName   String?
  lastName    String?
  staffType   StaffType        @default(PREPARER)
  roleKeys    String[]
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  firm      Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([firmId, status])
  @@index([email])
}

/// Branded onboarding link (new) / verified portal link (returning)
model OnboardingLink {
  id          String             @id @default(cuid())
  firmId      String
  clientId    String
  type        OnboardingLinkType @default(NEW_CLIENT)
  tokenHash   String             @unique
  sentTo      String?
  sentVia     OtpChannel?
  createdById String?
  expiresAt   DateTime
  openedAt    DateTime?
  completedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime           @default(now())

  firm      Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("OnboardingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId])
}

// =============================================================================
// 3. CLIENTS (taxpayer entities)
// =============================================================================

/// A taxpayer entity (individual/household or business). Owns many Cases across years.
model Client {
  id                  String              @id @default(cuid())
  firmId              String
  clientNumber        String?
  type                ClientType          @default(INDIVIDUAL)
  status              ClientStatus        @default(ONBOARDING)
  displayName         String
  legalName           String?
  email               String?
  phone               String?
  website             String?
  preferredChannel    OtpChannel?
  preferredLanguage   String?             @default("en")
  // individual
  defaultFilingStatus FilingStatus?
  // business
  entityType          BusinessEntityType?
  einEncrypted        String?
  einLast4            String?
  stateOfFormation    String?
  fiscalYearEndMonth  Int?
  businessStartDate   DateTime?
  naicsCode           String?
  // ownership
  primaryMemberId     String? // default preparer for new cases (scalar to avoid cycle)
  source              String? // referral, web, import
  referredBy          String?
  importJobId         String?
  onboardedAt         DateTime?
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  firm      Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  importJob ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  access          ClientAccess[]
  persons         ClientPerson[]
  addresses       Address[]
  cases           Case[]
  onboardingLinks OnboardingLink[]
  documents       Document[]
  invoices        Invoice[]
  messageThreads  MessageThread[]
  appointments    Appointment[]
  callLogs        CallLog[]
  tags            ClientTag[]
  relationsFrom   ClientRelationship[] @relation("RelFrom")
  relationsTo     ClientRelationship[] @relation("RelTo")
  ghlOpportunities GhlOpportunity[]
  documentRequests DocumentRequest[]

  @@unique([firmId, clientNumber])
  @@index([firmId, status])
  @@index([firmId, displayName])
  @@index([firmId, email])
  @@index([firmId, deletedAt])
}

/// Portal login -> client entity access. One portal user can access many entities (household + businesses).
model ClientAccess {
  id          String            @id @default(cuid())
  clientId    String
  userId      String
  accessLevel ClientAccessLevel @default(FULL)
  isPrimary   Boolean           @default(false)
  invitedAt   DateTime?
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
}

/// People attached to a client: taxpayer, spouse (joint signing), dependents, business officers.
model ClientPerson {
  id           String           @id @default(cuid())
  clientId     String
  userId       String? // linked portal login (e.g., spouse signs separately)
  role         ClientPersonRole
  firstName    String
  middleName   String?
  lastName     String
  suffix       String?
  email        String?
  phone        String?
  dateOfBirth  DateTime?        @db.Date
  ssnEncrypted String?
  ssnLast4     String?
  occupation   String?
  relationship String? // for dependents: son, daughter...
  ownershipPct Decimal?         @db.Decimal(5, 2) // for partners/officers
  isSigner     Boolean          @default(false)
  dateOfDeath  DateTime?        @db.Date
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  client  Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  signers SignatureSigner[]

  @@index([clientId, role])
}

model Address {
  id         String      @id @default(cuid())
  clientId   String
  type       AddressType @default(HOME)
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String      @default("US")
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

/// LATER: link related entities (owner -> business, household members)
model ClientRelationship {
  id           String   @id @default(cuid())
  fromClientId String
  toClientId   String
  type         String // "owner_of", "spouse_of", "related"
  note         String?
  createdAt    DateTime @default(now())

  from Client @relation("RelFrom", fields: [fromClientId], references: [id], onDelete: Cascade)
  to   Client @relation("RelTo", fields: [toClientId], references: [id], onDelete: Cascade)

  @@unique([fromClientId, toClientId, type])
}

// =============================================================================
// 4. PIPELINE & AUTOMATION
// =============================================================================

model Pipeline {
  id          String   @id @default(cuid())
  firmId      String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm            Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  stages          PipelineStage[]
  cases           Case[]
  engagementTypes EngagementType[]
  automationRules AutomationRule[]

  @@index([firmId])
}

model PipelineStage {
  id              String        @id @default(cuid())
  pipelineId      String
  key             String // stable machine key
  name            String // firm-customizable label
  category        StageCategory // semantic meaning for automations/reports
  position        Int
  color           String?
  slaDays         Int? // overdue/stuck threshold
  isClientVisible Boolean       @default(true)
  clientLabel     String? // label shown in client portal
  isTerminal      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  pipeline          Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  cases             Case[]
  historyFrom       CaseStageHistory[] @relation("StageFrom")
  historyTo         CaseStageHistory[] @relation("StageTo")
  tasks             Task[]
  taskTemplateItems TaskTemplateItem[]
  automationRules   AutomationRule[]

  @@unique([pipelineId, key])
  @@index([pipelineId, position])
}

/// Stage automations: e.g. ALL_SIGNATURES_COMPLETED -> advance to Filing (FR-7, FR-21)
model AutomationRule {
  id         String            @id @default(cuid())
  firmId     String
  pipelineId String?
  stageId    String?
  name       String
  trigger    AutomationTrigger
  conditions Json? // e.g. {"returnType":["FORM_1040"]}
  actions    Json // [{type:"ADVANCE_STAGE",toStageKey:"filing"},{type:"CREATE_TASKS",templateId:"..."}]
  isActive   Boolean           @default(true)
  position   Int               @default(0)
  cronExpr   String? // for SCHEDULED trigger
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  firm     Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  pipeline Pipeline?       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    PipelineStage?  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  runs     AutomationRun[]

  @@index([firmId, trigger, isActive])
}

model AutomationRun {
  id          String    @id @default(cuid())
  ruleId      String
  caseId      String?
  status      JobStatus @default(QUEUED)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  case Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt])
  @@index([caseId])
}

/// Service/engagement type: bundles default pipeline + task template + doc checklist + pricing.
model EngagementType {
  id                   String      @id @default(cuid())
  firmId               String
  name                 String // "Individual 1040", "S-Corp 1120S"
  returnType           ReturnType?
  pipelineId           String?
  taskTemplateId       String?
  docRequestTemplateId String?
  defaultServiceItemId String?
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  firm               Firm                     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  pipeline           Pipeline?                @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  taskTemplate       TaskTemplate?            @relation(fields: [taskTemplateId], references: [id], onDelete: SetNull)
  docRequestTemplate DocumentRequestTemplate? @relation(fields: [docRequestTemplateId], references: [id], onDelete: SetNull)
  defaultServiceItem ServiceItem?             @relation(fields: [defaultServiceItemId], references: [id], onDelete: SetNull)
  cases              Case[]

  @@unique([firmId, name])
}

// =============================================================================
// 5. CASE (central container: client + tax year + return type)
// =============================================================================

model Case {
  id               String        @id @default(cuid())
  firmId           String
  clientId         String
  caseNumber       String // e.g. "C-000123" from FirmSequence
  title            String? // "John Smith - 2026 Tax Return"
  taxYear          Int
  returnType       ReturnType    @default(FORM_1040)
  engagementTypeId String?
  filingStatus     FilingStatus?
  pipelineId       String
  currentStageId   String
  stageEnteredAt   DateTime      @default(now())
  status           CaseStatus    @default(OPEN)
  priority         CasePriority  @default(NORMAL)
  preparerId       String? // current owner pointer (FR-8)
  reviewerId       String?
  dueDate          DateTime? // statutory or internal due date
  internalDueDate  DateTime?
  extensionFiled   Boolean       @default(false)
  extendedDueDate  DateTime?
  previousCaseId   String? // prior-year link for multi-year history
  finalizedAt      DateTime?
  finalizedById    String?
  filedAt          DateTime?
  archivedAt       DateTime?
  onHoldReason     String?
  // denormalized counters for fast dashboards (maintain in app/trigger)
  missingDocsCount Int           @default(0)
  pendingSigCount  Int           @default(0)
  balanceDueCents  Int           @default(0)
  openTaskCount    Int           @default(0)
  lastActivityAt   DateTime?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  firm           Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  engagementType EngagementType? @relation(fields: [engagementTypeId], references: [id], onDelete: SetNull)
  pipeline       Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  currentStage   PipelineStage   @relation(fields: [currentStageId], references: [id], onDelete: Restrict)
  preparer       FirmMember?     @relation("CasePreparer", fields: [preparerId], references: [id], onDelete: SetNull)
  reviewer       FirmMember?     @relation("CaseReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  previousCase   Case?           @relation("CaseYearChain", fields: [previousCaseId], references: [id], onDelete: SetNull)
  nextCases      Case[]          @relation("CaseYearChain")

  assignments       CaseAssignment[]
  collaborators     CaseCollaborator[]
  stageHistory      CaseStageHistory[]
  documentRequests  DocumentRequest[]
  documents         Document[]
  returnDrafts      ReturnDraft[]
  returnSummaries   ReturnSummary[]
  eFilings          EFiling[]
  signatureRequests SignatureRequest[]
  invoices          Invoice[]
  tasks             Task[]
  messageThreads    MessageThread[]
  appointments      Appointment[]
  callLogs          CallLog[]
  reminders         Reminder[]
  automationRuns    AutomationRun[]
  auditLogs         AuditLog[]
  tags              CaseTag[]

  @@unique([firmId, caseNumber])
  @@unique([clientId, taxYear, returnType])
  @@index([firmId, status, currentStageId])
  @@index([firmId, preparerId, status])
  @@index([firmId, taxYear])
  @@index([firmId, dueDate])
  @@index([firmId, stageEnteredAt])
  @@index([clientId])
}

/// Full assignment history. Reassignment closes one row and opens another (FR-8).
model CaseAssignment {
  id           String         @id @default(cuid())
  caseId       String
  memberId     String
  role         AssignmentRole @default(PREPARER)
  assignedById String?
  reason       String?
  startedAt    DateTime       @default(now())
  endedAt      DateTime?

  case       Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  member     FirmMember @relation("AssignmentMember", fields: [memberId], references: [id], onDelete: Restrict)
  assignedBy User?      @relation("AssignmentMadeBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([caseId, startedAt])
  @@index([memberId, endedAt])
}

/// Shared visibility beyond the assigned preparer (FR-3 "shared visibility settings")
model CaseCollaborator {
  caseId   String
  memberId String
  canEdit  Boolean  @default(true)
  addedAt  DateTime @default(now())

  case   Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  member FirmMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([caseId, memberId])
  @@index([memberId])
}

model CaseStageHistory {
  id               String    @id @default(cuid())
  caseId           String
  fromStageId      String?
  toStageId        String
  changedById      String?
  actorType        ActorType @default(USER)
  automationRuleId String?
  reason           String?
  durationSec      Int? // time spent in fromStage
  createdAt        DateTime  @default(now())

  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStage PipelineStage? @relation("StageFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   PipelineStage  @relation("StageTo", fields: [toStageId], references: [id], onDelete: Restrict)
  changedBy User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([toStageId, createdAt])
}

// =============================================================================
// 6. FILES & DOCUMENTS
// =============================================================================

/// Physical object in blob storage. Reused by documents, attachments, branding, recordings, reports.
model StoredFile {
  id              String          @id @default(cuid())
  firmId          String? // null = platform-level asset (e.g. Platform Owner's own avatar)
  provider        StorageProvider @default(S3)
  bucket          String
  key             String          @unique
  originalName    String
  mimeType        String
  sizeBytes       BigInt
  checksumSha256  String?
  kmsKeyId        String? // encryption at rest (FR-12)
  virusScanStatus VirusScanStatus @default(PENDING)
  virusScannedAt  DateTime?
  pageCount       Int?
  /// Provider-side id for the stored object. For GHL_MEDIA this is the
  /// GoHighLevel media file id, which is what the Media Library API needs to
  /// delete or re-read the file - `key` holds its public URL.
  externalFileId  String?
  uploadedById    String?
  uploadIp        String?
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?

  firm       Firm? @relation(fields: [firmId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  brandingLogos      FirmBranding[]      @relation("BrandingLogo")
  brandingFavicons   FirmBranding[]      @relation("BrandingFavicon")
  userAvatars        User[]              @relation("UserAvatar")
  documentVersions   DocumentVersion[]
  messageAttachments MessageAttachment[]
  signatureTemplates SignatureTemplate[]
  sigCertificates    SignatureRequest[]  @relation("SignatureCertificate")
  callRecordings     CallLog[]           @relation("CallRecording")
  reportRuns         ReportRun[]
  importJobs         ImportJob[]
  invoicePdfs        Invoice[]           @relation("InvoicePdf")

  @@index([firmId, createdAt])
}

model DocumentCategory {
  id        String   @id @default(cuid())
  firmId    String
  parentId  String?
  key       String
  name      String // "Income", "Deductions", "Identity", "Prior Returns"
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm          Firm                          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  parent        DocumentCategory?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      DocumentCategory[]            @relation("CategoryTree")
  requests      DocumentRequest[]
  documents     Document[]
  templateItems DocumentRequestTemplateItem[]

  @@unique([firmId, key])
}

/// Checklist line item: "W-2 - Employer" requested from the client (FR-9, FR-10)
model DocumentRequest {
  id               String                @id @default(cuid())
  firmId           String
  /// Optional: a request can exist before any tax case does. The client is the
  /// required anchor, since staff request documents from a CLIENT.
  caseId           String?
  clientId         String
  categoryId       String?
  templateItemId   String?
  title            String
  description      String?
  status           DocumentRequestStatus @default(MISSING)
  isRequired       Boolean               @default(true)
  isClientVisible  Boolean               @default(true)
  dueDate          DateTime?
  position         Int                   @default(0)
  createdById      String?
  reviewedById     String?
  receivedAt       DateTime?
  rejectedReason   String?
  waivedReason     String?
  remindersEnabled Boolean               @default(true)
  reminderCount    Int                   @default(0)
  lastRemindedAt   DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  firm         Firm                         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case         Case?                        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client       Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category     DocumentCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  templateItem DocumentRequestTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  createdBy    User?                        @relation("DocRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy   User?                        @relation("DocRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents    Document[]
  reminders    Reminder[]

  @@index([caseId, status])
  @@index([clientId, status])
  @@index([firmId, status, dueDate])
}

/// Logical document; bytes live in DocumentVersion -> StoredFile (FR-11 version history)
model Document {
  id               String             @id @default(cuid())
  firmId           String
  caseId           String?
  clientId         String // enables cross-year client document history
  requestId        String?
  categoryId       String?
  kind             DocumentKind       @default(CLIENT_SOURCE)
  visibility       DocumentVisibility @default(CLIENT_VISIBLE)
  title            String
  description      String?
  clientNote       String? // note the client added on upload
  taxYear          Int?
  currentVersionId String?            @unique
  versionCount     Int                @default(0)
  isFinal          Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  firm           Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case           Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  request        DocumentRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  category       DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currentVersion DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[] @relation("DocumentVersions")

  returnDrafts       ReturnDraft[]
  returnSummaries    ReturnSummary[]
  extractionJobs     ExtractionJob[]
  sigSourceFor       SignatureRequest[]  @relation("SignatureSourceDoc")
  sigSignedFor       SignatureRequest[]  @relation("SignatureSignedDoc")
  messageAttachments MessageAttachment[]

  @@index([caseId, kind])
  @@index([clientId, taxYear])
  @@index([requestId])
  @@index([firmId, createdAt])
}

model DocumentVersion {
  id             String        @id @default(cuid())
  documentId     String
  versionNumber  Int
  fileId         String
  uploadedById   String?
  uploadedVia    UploadChannel @default(PORTAL)
  note           String?
  replacedReason String?
  createdAt      DateTime      @default(now())

  document   Document   @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentOf  Document?  @relation("CurrentVersion")
  file       StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
  @@index([fileId])
}

/// Reusable document checklists (FR-30)
model DocumentRequestTemplate {
  id          String      @id @default(cuid())
  firmId      String
  name        String
  description String?
  returnType  ReturnType?
  clientType  ClientType?
  isActive    Boolean     @default(true)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  firm            Firm                          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  items           DocumentRequestTemplateItem[]
  engagementTypes EngagementType[]

  @@unique([firmId, name])
}

model DocumentRequestTemplateItem {
  id            String   @id @default(cuid())
  templateId    String
  categoryId    String?
  title         String
  description   String?
  isRequired    Boolean  @default(true)
  dueOffsetDays Int? // relative to case creation
  position      Int      @default(0)
  conditions    Json? // LATER: include only if e.g. filingStatus = MFJ
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  template DocumentRequestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category DocumentCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  requests DocumentRequest[]

  @@index([templateId, position])
}

// =============================================================================
// 7. DRAFT REVIEW, RETURN FIGURES, FINAL FILING
// =============================================================================

/// Draft return shared with client for review/approval (FR-16..18)
model ReturnDraft {
  id             String      @id @default(cuid())
  firmId         String
  caseId         String
  documentId     String
  versionNumber  Int
  status         DraftStatus @default(UPLOADED)
  summaryText    String? // preparer's cover note
  uploadedById   String?
  sentToClientAt DateTime?
  clientViewedAt DateTime?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedBy User?    @relation("DraftUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  decidedBy  User?    @relation("DraftDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  comments          DraftComment[]
  summaries         ReturnSummary[]
  signatureRequests SignatureRequest[]

  @@unique([caseId, versionNumber])
  @@index([firmId, status])
}

model DraftComment {
  id           String             @id @default(cuid())
  draftId      String
  authorId     String?
  authorType   MessageAuthorType  @default(CLIENT)
  action       DraftCommentAction @default(COMMENT)
  body         String?
  pageNumber   Int?
  anchor       Json? // LATER: highlight coordinates
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime           @default(now())

  draft  ReturnDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([draftId, createdAt])
}

/// Key figures (draft preview or final extraction: AGI, CTC, EIC, QBI) (FR-32)
model ReturnSummary {
  id                 String            @id @default(cuid())
  firmId             String
  caseId             String
  draftId            String?
  documentId         String?
  type               ReturnSummaryType
  filingStatus       FilingStatus?
  totalIncome        Decimal?          @db.Decimal(14, 2)
  agi                Decimal?          @db.Decimal(14, 2)
  taxableIncome      Decimal?          @db.Decimal(14, 2)
  standardDeduction  Decimal?          @db.Decimal(14, 2)
  itemizedDeductions Decimal?          @db.Decimal(14, 2)
  qbiDeduction       Decimal?          @db.Decimal(14, 2)
  totalTax           Decimal?          @db.Decimal(14, 2)
  childTaxCredit     Decimal?          @db.Decimal(14, 2)
  additionalCtc      Decimal?          @db.Decimal(14, 2)
  earnedIncomeCredit Decimal?          @db.Decimal(14, 2)
  totalPayments      Decimal?          @db.Decimal(14, 2)
  federalRefund      Decimal?          @db.Decimal(14, 2)
  federalBalanceDue  Decimal?          @db.Decimal(14, 2)
  stateRefund        Decimal?          @db.Decimal(14, 2)
  stateBalanceDue    Decimal?          @db.Decimal(14, 2)
  extraFigures       Json? // any additional line items
  extractionMethod   ExtractionMethod  @default(MANUAL)
  confidence         Decimal?          @db.Decimal(5, 4)
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  firm       Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case       Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  draft      ReturnDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  document   Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  verifiedBy User?        @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([caseId, type])
  @@index([firmId, type])
}

/// OCR / parsing job over a document
model ExtractionJob {
  id          String           @id @default(cuid())
  firmId      String
  documentId  String
  method      ExtractionMethod @default(OCR)
  provider    String?
  status      JobStatus        @default(QUEUED)
  result      Json?
  error       String?
  attempts    Int              @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  firm     Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status, createdAt])
}

/// LATER: e-file transmission tracking per jurisdiction (federal + each state)
model EFiling {
  id             String      @id @default(cuid())
  firmId         String
  caseId         String
  jurisdiction   String // "FED", "CA", "NY"
  formType       String?
  status         EFileStatus @default(NOT_STARTED)
  submissionId   String?
  transmittedAt  DateTime?
  acknowledgedAt DateTime?
  rejectionCodes String[]
  rejectionNotes String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, jurisdiction])
  @@index([firmId, status])
}

// =============================================================================
// 8. E-SIGNATURE (FR-19..21)
// =============================================================================

model SignatureTemplate {
  id             String           @id @default(cuid())
  firmId         String
  name           String
  kind           SignatureDocKind
  fileId         String?
  bodyHtml       String? // for engagement letters rendered from HTML
  fieldMap       Json? // signature/date/initial field coordinates
  requiresSpouse Boolean          @default(false)
  isActive       Boolean          @default(true)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  firm     Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  file     StoredFile?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  requests SignatureRequest[]

  @@index([firmId, kind])
}

model SignatureRequest {
  id                   String                 @id @default(cuid())
  firmId               String
  caseId               String
  templateId           String?
  draftId              String?
  kind                 SignatureDocKind
  title                String
  status               SignatureRequestStatus @default(DRAFT)
  sessionType          SignatureSessionType   @default(SINGLE)
  signingOrderEnforced Boolean                @default(false)
  sourceDocumentId     String?
  signedDocumentId     String?
  certificateFileId    String? // certificate of completion
  provider             String? // "native", "docusign", "dropbox_sign"
  providerEnvelopeId   String?                @unique
  sentById             String?
  sentAt               DateTime?
  expiresAt            DateTime?
  completedAt          DateTime?
  voidedAt             DateTime?
  voidReason           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  firm           Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case           Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template       SignatureTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  draft          ReturnDraft?       @relation(fields: [draftId], references: [id], onDelete: SetNull)
  sourceDocument Document?          @relation("SignatureSourceDoc", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  signedDocument Document?          @relation("SignatureSignedDoc", fields: [signedDocumentId], references: [id], onDelete: SetNull)
  certificate    StoredFile?        @relation("SignatureCertificate", fields: [certificateFileId], references: [id], onDelete: SetNull)
  sentBy         User?              @relation("SignatureSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  signers        SignatureSigner[]
  events         SignatureEvent[]
  reminders      Reminder[]

  @@index([caseId, status])
  @@index([firmId, status])
}

model SignatureSigner {
  id                String              @id @default(cuid())
  requestId         String
  userId            String?
  personId          String? // ClientPerson (taxpayer/spouse)
  memberId          String? // preparer countersign (8879 ERO)
  role              SignerRole          @default(TAXPAYER)
  name              String
  email             String?
  phone             String?
  signingOrder      Int                 @default(1)
  status            SignerStatus        @default(PENDING)
  authMethod        SignatureAuthMethod @default(PORTAL_SESSION)
  accessTokenHash   String?             @unique
  signatureImageKey String? // storage key of drawn/typed signature
  typedName         String?
  consentAcceptedAt DateTime? // ESIGN consent
  viewedAt          DateTime?
  signedAt          DateTime?
  declinedAt        DateTime?
  declineReason     String?
  ipAddress         String?
  userAgent         String?
  geoLocation       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  person  ClientPerson?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  member  FirmMember?      @relation("SignerMember", fields: [memberId], references: [id], onDelete: SetNull)
  events  SignatureEvent[]

  @@index([requestId, signingOrder])
  @@index([userId])
}

/// Immutable e-sign audit trail (IP, timestamp, signer identity) (FR-20)
model SignatureEvent {
  id        String             @id @default(cuid())
  requestId String
  signerId  String?
  type      SignatureEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime           @default(now())

  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  signer  SignatureSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

// =============================================================================
// 9. PAYMENTS (Stripe Connect) (FR-22..25)
// =============================================================================

model StripeAccount {
  id                      String            @id @default(cuid())
  firmId                  String            @unique
  stripeAccountId         String            @unique // acct_...
  type                    StripeAccountType @default(STANDARD)
  chargesEnabled          Boolean           @default(false)
  payoutsEnabled          Boolean           @default(false)
  detailsSubmitted        Boolean           @default(false)
  country                 String?
  defaultCurrency         String?
  applicationFeeBps       Int? // platform take-rate in basis points (optional model)
  applicationFeeFlatCents Int?
  connectedAt             DateTime?
  disconnectedAt          DateTime?
  requirements            Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

/// Price catalog (LATER: used by engagement types and invoice lines)
model ServiceItem {
  id             String   @id @default(cuid())
  firmId         String
  name           String
  description    String?
  unitPriceCents Int
  taxable        Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  firm            Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  lineItems       InvoiceLineItem[]
  engagementTypes EngagementType[]

  @@unique([firmId, name])
}

model Invoice {
  id                      String        @id @default(cuid())
  firmId                  String
  caseId                  String?
  clientId                String
  number                  String
  status                  InvoiceStatus @default(DRAFT)
  currency                String        @default("usd")
  subtotalCents           Int           @default(0)
  discountCents           Int           @default(0)
  taxCents                Int           @default(0)
  totalCents              Int           @default(0)
  amountPaidCents         Int           @default(0)
  amountRefundedCents     Int           @default(0)
  amountDueCents          Int           @default(0)
  memo                    String?
  issuedAt                DateTime?
  dueDate                 DateTime?
  paidAt                  DateTime?
  voidedAt                DateTime?
  stripeInvoiceId         String?       @unique
  stripeCheckoutSessionId String?       @unique
  hostedPaymentUrl        String?
  pdfFileId               String?
  autoRemind              Boolean       @default(true)
  reminderCount           Int           @default(0)
  lastRemindedAt          DateTime?
  createdById             String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?

  firm      Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case      Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  pdf       StoredFile?       @relation("InvoicePdf", fields: [pdfFileId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems InvoiceLineItem[]
  payments  Payment[]
  reminders Reminder[]

  @@unique([firmId, number])
  @@index([firmId, status, dueDate])
  @@index([caseId])
  @@index([clientId])
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  serviceItemId  String?
  description    String
  quantity       Decimal @default(1) @db.Decimal(10, 2)
  unitPriceCents Int
  amountCents    Int
  taxable        Boolean @default(false)
  position       Int     @default(0)

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id                    String            @id @default(cuid())
  firmId                String
  invoiceId             String
  paidById              String?
  amountCents           Int
  currency              String            @default("usd")
  applicationFeeCents   Int?
  stripeFeeCents        Int?
  netCents              Int?
  method                PaymentMethodType @default(CARD)
  status                PaymentStatus     @default(PENDING)
  stripePaymentIntentId String?           @unique
  stripeChargeId        String?           @unique
  cardBrand             String?
  cardLast4             String?
  receiptUrl            String?
  failureCode           String?
  failureMessage        String?
  paidAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  firm    Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paidBy  User?    @relation("PaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  refunds Refund[]

  @@index([firmId, status, createdAt])
  @@index([invoiceId])
}

model Refund {
  id             String        @id @default(cuid())
  paymentId      String
  amountCents    Int
  reason         String?
  status         PaymentStatus @default(PENDING)
  stripeRefundId String?       @unique
  createdById    String?
  createdAt      DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// =============================================================================
// 10. TASKS
// =============================================================================

model Task {
  id               String       @id @default(cuid())
  firmId           String
  caseId           String?
  parentTaskId     String?
  stageId          String? // task belongs to a pipeline stage
  templateItemId   String?
  callLogId        String? // Voice-AI follow-up
  title            String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(NORMAL)
  source           TaskSource   @default(MANUAL)
  assigneeId       String?
  isClientTask     Boolean      @default(false) // shows in client "Needs your attention"
  isBlocking       Boolean      @default(false) // must complete before stage exit
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  completedById    String?
  createdById      String?
  position         Int          @default(0)
  estimatedMinutes Int? // LATER: capacity planning
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  firm         Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  case         Case?             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  parent       Task?             @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]            @relation("Subtasks")
  stage        PipelineStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  templateItem TaskTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  callLog      CallLog?          @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  assignee     FirmMember?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy  User?             @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy    User?             @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  comments     TaskComment[]
  reminders    Reminder[]

  @@index([firmId, assigneeId, status])
  @@index([caseId, status])
  @@index([firmId, dueAt])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskTemplate {
  id          String      @id @default(cuid())
  firmId      String
  name        String
  description String?
  returnType  ReturnType?
  isActive    Boolean     @default(true)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  firm            Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  items           TaskTemplateItem[]
  engagementTypes EngagementType[]

  @@unique([firmId, name])
}

model TaskTemplateItem {
  id              String          @id @default(cuid())
  templateId      String
  stageId         String? // create when case enters this stage
  title           String
  description     String?
  priority        TaskPriority    @default(NORMAL)
  defaultAssignee AssignmentRole? // assign to case preparer/reviewer
  dueOffsetDays   Int?
  isClientTask    Boolean         @default(false)
  isBlocking      Boolean         @default(false)
  position        Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  template TaskTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stage    PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  tasks    Task[]

  @@index([templateId, position])
}

// =============================================================================
// 11. MESSAGING (case-bound, never personal inbox) (FR-13)
// =============================================================================

model MessageThread {
  id            String     @id @default(cuid())
  firmId        String
  clientId      String
  caseId        String? // null = client-level general thread
  type          ThreadType @default(CLIENT)
  subject       String?
  isArchived    Boolean    @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case     Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([firmId, lastMessageAt])
  @@index([caseId, type])
  @@index([clientId])
}

model Message {
  id                String            @id @default(cuid())
  firmId            String
  threadId          String
  authorId          String?
  authorType        MessageAuthorType
  channel           MessageChannel    @default(PORTAL)
  body              String
  bodyHtml          String?
  isInternalNote    Boolean           @default(false)
  externalMessageId String? // inbound email/SMS id
  replyToId         String?
  editedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())

  firm        Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  thread      MessageThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  replyTo     Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]           @relation("MessageReplies")
  attachments MessageAttachment[]
  receipts    MessageReceipt[]

  @@index([threadId, createdAt])
  @@index([firmId, createdAt])
}

model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String
  fileId     String?
  documentId String? // when attachment is promoted to a case document
  createdAt  DateTime @default(now())

  message  Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file     StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  document Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([messageId])
}

model MessageReceipt {
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

// =============================================================================
// 12. APPOINTMENTS & CALENDAR
// =============================================================================

model AppointmentType {
  id               String                  @id @default(cuid())
  firmId           String
  name             String
  description      String?
  durationMinutes  Int                     @default(30)
  bufferMinutes    Int                     @default(0)
  locationType     AppointmentLocationType @default(PHONE)
  isClientBookable Boolean                 @default(true)
  color            String?
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  firm         Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([firmId, name])
}

model Appointment {
  id                      String                  @id @default(cuid())
  firmId                  String
  typeId                  String?
  hostId                  String // FirmMember
  clientId                String?
  caseId                  String?
  callLogId               String? // booked by Voice AI
  title                   String
  description             String?
  startAt                 DateTime
  endAt                   DateTime
  timezone                String
  status                  AppointmentStatus       @default(SCHEDULED)
  locationType            AppointmentLocationType @default(PHONE)
  location                String?
  meetingUrl              String?
  bookedById              String?
  bookedVia               BookingSource           @default(TEAM)
  externalCalendarEventId String?
  cancelledAt             DateTime?
  cancelReason            String?
  rescheduledFromId       String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  firm            Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  type            AppointmentType?      @relation(fields: [typeId], references: [id], onDelete: SetNull)
  host            FirmMember            @relation("AppointmentHost", fields: [hostId], references: [id], onDelete: Restrict)
  client          Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case            Case?                 @relation(fields: [caseId], references: [id], onDelete: SetNull)
  callLog         CallLog?              @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  bookedBy        User?                 @relation("AppointmentBookedBy", fields: [bookedById], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment?          @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Appointment[]         @relation("Reschedule")
  attendees       AppointmentAttendee[]
  reminders       Reminder[]

  @@index([firmId, startAt])
  @@index([hostId, startAt])
  @@index([clientId])
  @@index([caseId])
}

model AppointmentAttendee {
  id            String           @id @default(cuid())
  appointmentId String
  userId        String?
  name          String?
  email         String?
  phone         String?
  response      AttendeeResponse @default(PENDING)
  createdAt     DateTime         @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

/// Weekly working hours for booking
model AvailabilityRule {
  id          String   @id @default(cuid())
  memberId    String
  dayOfWeek   Int // 0=Sun..6=Sat
  startMinute Int // minutes from midnight
  endMinute   Int
  timezone    String
  createdAt   DateTime @default(now())

  member FirmMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, dayOfWeek])
}

model AvailabilityException {
  id          String   @id @default(cuid())
  memberId    String
  startAt     DateTime
  endAt       DateTime
  isAvailable Boolean  @default(false) // false = time off
  reason      String?
  createdAt   DateTime @default(now())

  member FirmMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, startAt])
}

/// LATER: two-way Google/Outlook sync
