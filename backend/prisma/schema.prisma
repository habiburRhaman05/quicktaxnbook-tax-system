/// Firm reminder policy, e.g. unpaid invoice: remind at +3, +7, +14 days
model ReminderRule {
  id           String                @id @default(cuid())
  firmId       String
  target       ReminderTarget
  name         String
  offsetsDays  Int[] // relative to createdAt/dueDate
  relativeTo   String                @default("dueDate")
