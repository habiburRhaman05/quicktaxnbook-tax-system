// =============================================================================
// Qicktaxnbook365 · Tax Practice Platform · Prisma Schema (PostgreSQL)
// -----------------------------------------------------------------------------
// Design rules
//  1. Multi-tenant: every top-level business table carries `firmId` (FR-4).
//     Child tables (versions, line items, signers, events) inherit tenancy
//     through their parent. Enforce with Postgres RLS + a Prisma extension
//     that injects `firmId` on every query.
//  2. The Case (client + tax year + return type) is the central container.
//     Reassignment only moves an owner pointer; history lives in
//     CaseAssignment + CaseStageHistory + AuditLog (FR-8).
//  3. Nothing business-critical is hard-deleted: `deletedAt` soft deletes.
//  4. Money for billing = integer cents (Stripe native).
//     Tax figures = Decimal(14,2).
//  5. PII (SSN/EIN, OAuth tokens, TOTP secrets) stored app-level encrypted
//     in `*Encrypted` columns. Only last-4 stored in clear.
//  6. Tables/fields marked "LATER" are scaffolding for roadmap features and
//     are optional/nullable so they cost nothing until used.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev working on whatever OS you're on; the rhel
  // target matches Vercel's serverless Node.js runtime (Amazon Linux).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Used only for migrations. On Vercel, DATABASE_URL should be Neon's
  // pooled (PgBouncer) connection string - serverless functions open many
  // short-lived connections, and pooling keeps that from exhausting Postgres.
  // Migrations need a direct (non-pooled) connection, hence this separate URL.
  directUrl = env("DIRECT_URL")
}

