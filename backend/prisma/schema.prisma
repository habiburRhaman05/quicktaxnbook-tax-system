/// Agency-scope (company) GoHighLevel credential. Kept separate from
/// `Integration` because that model is firm-scoped and unique per
/// [firmId, provider] - an agency connection belongs to no single firm.
/// `companyId` is unique, so more than one agency can be connected later
/// without a schema change.
model GhlAgencyConnection {
  id            String            @id @default(cuid())
  /// Agency (company) id in GoHighLevel, derived from the token when possible.
  companyId     String?           @unique
  companyName   String?
  /// GoHighLevel "Relationship Number" the platform owner enters alongside the token.
  relationshipNumber String?
  /// AES-256-GCM encrypted agency private integration token (never logged, never selected into a response).
  tokenEncrypted String
  status        IntegrationStatus @default(CONNECTED)
  lastVerifiedAt DateTime?
  lastError     String?

  connectedById String?
  connectedBy   User?   @relation("GhlAgencyConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The vocabulary the CLIENT portal shows, independent of how any one firm
/// named its GoHighLevel stages. Every mirrored stage maps onto exactly one of
/// these (see ghl.stage-map.ts), so the client sees the same five steps whether
/// their return runs through the Individual, S-Corp or Payroll pipeline.
enum ClientDocStage {
  REQUESTED
  RECEIVED
  IN_PROGRESS
  READY_FOR_REVIEW
  AWAITING_SIGNATURE
  AWAITING_PAYMENT
  COMPLETED
}

// ---------------------------------------------------------------------------
// GoHighLevel opportunity mirror
// ---------------------------------------------------------------------------
// These three tables are a LOCAL CACHE of what lives in a firm's GoHighLevel
// sub-account - never the source of truth. GoHighLevel owns this data; we
// reconcile against it (see modules/ghl/ghl.opportunity-sync.ts) and anything
// here that no longer exists upstream is deleted on the next sync.
//
// They are deliberately separate from the internal `Pipeline`/`PipelineStage`
// models above: those drive tax-case workflow inside this app and are firm-
// editable, whereas these only ever reflect GoHighLevel.

/// Mirror of one GoHighLevel pipeline in a firm's sub-account.
model GhlPipeline {
  id            String   @id @default(cuid())
  firmId        String
  /// Pipeline id in GoHighLevel - the reconcile key.
  ghlPipelineId String
  name          String
  /// Set on the pipeline this firm uses for document tracking.
  isDocumentPipeline Boolean @default(false)
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  firm          Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  stages        GhlPipelineStage[]
  opportunities GhlOpportunity[]

  @@unique([firmId, ghlPipelineId])
  @@index([firmId, isDocumentPipeline])
}

/// Mirror of a stage within a GoHighLevel pipeline.
model GhlPipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  /// Stage id in GoHighLevel - the reconcile key, and what we send on update.
  ghlStageId String
  name       String
  position   Int      @default(0)
  /// Client-facing bucket this stage rolls up to. Firms name their stages
  /// differently per pipeline ("Return in Progress" vs "941 / W-2 / 1099 In
  /// Progress"), but the client portal must show one consistent vocabulary -
  /// so each mirrored stage is classified once, here, on sync.
  clientStage ClientDocStage @default(IN_PROGRESS)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline      GhlPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities GhlOpportunity[]

  @@unique([pipelineId, ghlStageId])
  @@index([pipelineId, position])
}

/// Mirror of a GoHighLevel opportunity. One per tracked document.
model GhlOpportunity {
  id               String  @id @default(cuid())
  firmId           String
  /// Opportunity id in GoHighLevel - the reconcile key.
  ghlOpportunityId String
  pipelineId       String
  stageId          String?
  /// GoHighLevel contact this opportunity hangs off.
  ghlContactId     String?
  /// Resolved local client, when the contact maps to one. Null while unmatched.
  clientId         String?
  name             String
  /// GoHighLevel's own status: open / won / lost / abandoned.
  status           String  @default("open")
  monetaryValue    Decimal? @db.Decimal(12, 2)
  /// Raw custom fields from GoHighLevel (file_url, file_id, uploaded_by, ...).
  customFields     Json?
  /// Timestamps as reported by GoHighLevel, used to detect upstream changes.
  ghlCreatedAt     DateTime?
  ghlUpdatedAt     DateTime?
  lastSyncedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  firm     Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  pipeline GhlPipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    GhlPipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  client   Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([firmId, ghlOpportunityId])
  @@index([firmId, pipelineId])
  @@index([clientId])
  @@index([ghlContactId])
}

/// Inbound webhooks (Stripe, Twilio, e-sign) for idempotency + replay
model WebhookEvent {
  id          String             @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  firmId      String? // resolved tenant (scalar, may be unknown on receipt)
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
  @@index([status, receivedAt])
}

/// LATER: outbound webhooks for firm integrations (Zapier etc.)
model WebhookEndpoint {
